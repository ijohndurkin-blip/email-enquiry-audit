{
  "functions": {
    "api/audit.js": { "maxDuration": 60 },
    "api/connect.js": { "maxDuration": 60 },
    "api/classify.js": { "maxDuration": 60 },
    "api/summary.js": { "maxDuration": 60 },
    "api/store.js": { "maxDuration": 30 },
    "api/thread.js": { "maxDuration": 30 },
    "api/quality.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
